# ------------------------------------------------------------------
# Supabase project credentials
# Copy this file to .env.local and fill in real values for each app.
# Get these from: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------

# Project URL (e.g. https://abcdefghijklmnopqrst.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Anon (public) key - safe to expose in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key - SERVER ONLY. Never expose to the browser.
# Used by lib/supabase/admin.ts to bypass RLS for server-side logic.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used to build absolute OAuth / email redirect URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
